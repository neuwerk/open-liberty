<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <display-name>untBasicProvider</display-name>

    <servlet>
        <servlet-name>untBasicProvider</servlet-name>
        <servlet-class>com.ibm.ws.wssecurity.fat.untmmbasicprovider.UsrTokenWebSvc</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>untBasicProvider</servlet-name>
        <url-pattern>/SOAPService2</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

</web-app>
